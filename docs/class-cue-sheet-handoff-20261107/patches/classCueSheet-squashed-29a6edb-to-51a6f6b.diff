+    if (idx !== -1) {
+      selectStepByIndex(idx, 'user-navigation');
+    }
+  };
+
+  const transferFocusToDeckIfBoundary = (willDisableButton: boolean) => {
+    hadFocusInsideRootRef.current = true;
