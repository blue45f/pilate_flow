+    .replace(/vbscript\s*:/gi, 'vbscript&#58;')
+    .replace(/data\s*:\s*text\/html/gi, 'data&#58;text/html')
+    .replace(/\bon([a-z0-9_]+)\s*=/gi, 'on$1&#61;');
+
+  return neutralized
+    .split('\n')
+    .map((line) => line.replace(/[ \t]+/g, ' ').trim())
+    .join('\n')
+    .trim();
