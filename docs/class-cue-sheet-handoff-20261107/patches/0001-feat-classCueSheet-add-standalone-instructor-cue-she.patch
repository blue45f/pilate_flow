+function redactAndSanitizeText(value: unknown, tracker: RedactionTracker): string {
+  if (value === null || value === undefined) return '';
+  if (typeof value !== 'string' && typeof value !== 'number' && typeof value !== 'boolean') {
+    return '';
+  }
+  let text = String(value);
