+    if (ancestors.has(obj)) {
+      cycleEdges.add(`${parentId}->${currentId}:${edgeLabel}`);
+      return;
+    }
+    if (fullyVisited.has(obj) || visitedNodeCount >= MAX_SCAN_NODES) {
+      return;
+    }
