+          btn.click();
+          await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+
+          const compactBtn = Array.from(document.querySelectorAll('.cue-sheet-view-buttons button'))
+            .find((b) => b.textContent && b.textContent.includes('기본 진행표'));
