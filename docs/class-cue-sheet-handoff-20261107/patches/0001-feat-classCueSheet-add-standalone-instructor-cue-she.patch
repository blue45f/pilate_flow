+    expect(
+      within(currentSection).getByText(/등록된 수업 진행 항목이 없습니다/),
+    ).toBeTruthy();
+
+    const nextSection = screen.getByRole('region', { name: '다음 준비 항목' });
+    expect(
+      within(nextSection).getByText(/마지막 항목입니다 · 다음 예정 항목 없음/),
+    ).toBeTruthy();
