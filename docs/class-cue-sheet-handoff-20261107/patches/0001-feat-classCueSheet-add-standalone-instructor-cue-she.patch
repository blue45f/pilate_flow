+
+    const printComputed = await session.evaluate<{
+      noPrintDisplays: string[];
+      rootColor: string;
+      rootBg: string;
+      summaryBreakInside: string;
+      longCueOverflow: string;
+      longCueMaxHeight: string;
+      longCueWhiteSpace: string;
+      longCueBreakInside: string;
