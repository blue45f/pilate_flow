+    visitedNodeCount += 1;
+    ancestors.add(obj);
+
+    if (Array.isArray(node)) {
+      for (let i = 0; i < node.length; i += 1) {
+        walk(node[i], currentId, `[${i}]`);
+      }
+    } else {
