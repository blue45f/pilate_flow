+
+    // Switch to long-korean-cues-empty-cues-duplicates in compact mode
+    await session.evaluate(`(async () => {
+      const btn = document.querySelector('button[data-fixture-id="long-korean-cues-empty-cues-duplicates"]');
+      btn.click();
