{
  "name": "pilates-flow-studio",
  "version": "1.0.0",
  "private": true,
  "description": "50-Minute Pilates Sequence Builder, YouTube Exercise Clipper & Class Memory Co-Pilot for Instructors",
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-exercise-artwork.mjs --check && tsc -b && vite build && node scripts/check-pwa-build.mjs",
    "generate:motion-artwork": "node scripts/generate-exercise-artwork.mjs",
    "check:motion-artwork": "node scripts/generate-exercise-artwork.mjs --check",
    "test:motion-artwork": "node --test scripts/generate-exercise-artwork.node-test.mjs",
    "preview": "vite preview",
    "test": "node --test src/booking-core/test/booking-engine.test.mjs src/utils/recurrence/test/pilates-recurrence.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:deploy": "node --test scripts/check-pwa-build.node-test.mjs scripts/deploy-universal.node-test.mjs scripts/setup-deploy-auth.node-test.mjs scripts/firebase-local.node-test.mjs",
    "check:motion-study": "node scripts/generate-motion-study-ledger.mjs --check && node --test scripts/generate-motion-study-ledger.node-test.mjs",
    "check:pwa": "node scripts/check-pwa-build.mjs",
    "check:secrets": "node --test scripts/check-secrets.node-test.mjs && node scripts/check-secrets.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "verify:all": "pnpm check:secrets && pnpm check:motion-study && pnpm test:deploy && pnpm test:motion-artwork && pnpm lint && pnpm build && pnpm test",
    "deploy": "node scripts/deploy-universal.mjs",
    "deploy:doctor": "node scripts/deploy-universal.mjs --doctor",
    "deploy:auth": "node scripts/setup-deploy-auth.mjs",
    "deploy:auth:check": "node scripts/setup-deploy-auth.mjs --status",
    "deploy:auth:local": "node scripts/setup-deploy-auth.mjs --reuse-login --local-only",
    "deploy:info": "node scripts/setup-deploy-auth.mjs --status --local-only",
    "firebase:local": "node scripts/firebase-local.mjs",
    "deploy:check": "node scripts/deploy-universal.mjs --check-env",
    "deploy:verify": "node scripts/deploy-universal.mjs --verify-live",
    "deploy:rollback": "node scripts/deploy-universal.mjs --rollback"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "firebase": "13.2.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.2",
    "sharp": "0.34.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
