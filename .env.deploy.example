# Pilates Flow Atelier — 로컬 배포 및 서버 환경변수 템플릿 (.env.deploy.example)
#
# 사용 방법:
#   1) 터미널에서 `pnpm deploy:auth` 를 1회 실행하면 `.env.deploy.local` 생성과
#      GitHub Actions 시크릿 동기화까지 자동으로 안내·처리합니다.
#   2) 수동으로 설정할 경우 이 파일을 `.env.deploy.local` 로 복사한 뒤 아래 중 하나만 채우세요.
#      (`.env.deploy.local`, `.env.local`, `.firebase/` 는 모두 Git 추적에서 자동 제외됩니다.)

# [권장 1] Firebase 서비스 계정 JSON 파일 경로 (프로젝트 루트 기준 상대 경로 또는 절대 경로)
# `.firebase/service-account.json` 에 파일을 두면 아래 항목을 비워 두어도 자동 감지됩니다.
GOOGLE_APPLICATION_CREDENTIALS=

# [권장 2] 서비스 계정 JSON 원문(한 줄) 또는 Base64 인코딩 문자열
FIREBASE_SERVICE_ACCOUNT=

# [대안 3] `npx firebase-tools@13.29.1 login:ci` 로 발급한 비대화형 배포 토큰
FIREBASE_TOKEN=

# [선택] 서버 전용 사용자 등록 OpenAI API 키 우선순위 설정 (`BACKEND.md` 참고)
USER_OPENAI_API_KEY=
OPENAI_USER_API_KEYS_JSON=
OPENAI_API_KEY=
