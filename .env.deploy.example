# Pilates Flow Atelier — 로컬 배포 및 서버 환경변수 템플릿 (.env.deploy.example)
#
# 사용 방법:
#   1) `pnpm deploy:auth:local`로 기존 Firebase CLI 로그인을 재사용해 로컬에 저장합니다.
#      새 토큰 발급과 GitHub Actions 시크릿 변경은 하지 않습니다.
#   2) 인증이 이미 저장돼 있으면 `pnpm deploy:info`로 상태만 확인하세요.
#   3) 수동 설정은 이 파일을 `.env.deploy.local`로 복사하고 아래 인증 중 하나만 채웁니다.
#      실제 env는 Git 제외·권한 0600을 유지하고 source/eval하거나 값을 출력하지 않습니다.
#   4) 다른 앱의 실행 진입점과 승인된 배포 절차는 DEPLOYMENT.md를 참고하세요.

# [배포 참고 정보] 실제 대상은 firebase.json / .firebaserc / 배포 스크립트가 검증합니다.
# 절대 경로는 해당 PC와 체크아웃에 맞게 설정합니다. 배포 대상 override 용도가 아닙니다.
DEPLOY_PROJECT_ROOT=
DEPLOY_ENV_FILE=
DEPLOY_LAUNCHER=
DEPLOY_GUIDE=
FIREBASE_PROJECT_ID=deskcloud-fleet-auth
FIREBASE_HOSTING_SITE=pilates-flow-atelier
FIREBASE_HOSTING_URL=https://pilates-flow-atelier.web.app
DEPLOY_BRANCH=main
DEPLOY_REPOSITORY=https://github.com/blue45f/pilate_flow
DEPLOY_NODE_BIN=
DEPLOY_FIREBASE_TOOLS_PACKAGE=firebase-tools@13.29.1

# [권장 1] Firebase 서비스 계정 JSON 파일 경로 (프로젝트 루트 기준 상대 경로 또는 절대 경로)
# `.firebase/service-account.json` 에 파일을 두면 아래 항목을 비워 두어도 자동 감지됩니다.
GOOGLE_APPLICATION_CREDENTIALS=

# [권장 2] 서비스 계정 JSON 원문(한 줄) 또는 Base64 인코딩 문자열
FIREBASE_SERVICE_ACCOUNT=

# [대안 3] 기존 Firebase CLI 로그인 또는 보관 중인 CI 토큰 재사용
# 배포 인증에는 VITE_ 접두사를 사용하지 않습니다.
FIREBASE_TOKEN=

# [선택] 서버 전용 사용자 등록 OpenAI API 키 우선순위 설정 (`BACKEND.md` 참고)
USER_OPENAI_API_KEY=
OPENAI_USER_API_KEYS_JSON=
OPENAI_API_KEY=
